# =============================================================================
# Mazed Immo — every environment variable the app reads
#
# Copy to .env.local and fill in. Both files are gitignored; this one is the
# checked-in map, and it is DERIVED from the real list, so it cannot drift:
# every `process.env.X` in src/ and scripts/ appears below exactly once.
#
# Sections 1-4 must be filled for the app to work. 5 and 6 are what turn on
# e-mail and the contact page. 7-8 are optional. 9 is local tooling only.
#
# Never commit a filled copy. SUPABASE_SERVICE_ROLE_KEY and SB_DB_PASSWORD
# each give full control of the database.
# =============================================================================

# ==========================================================================
# 1 · SUPABASE  —  REQUIRED
# Nothing runs without these three.
# ==========================================================================

# Public. Shipped to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Public. Shipped to the browser. RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# SERVER ONLY. Bypasses every RLS policy — full read/write on the whole
# database. Never expose it to a browser and never commit it.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ==========================================================================
# 2 · SITE  —  REQUIRED
# Absolute URLs in e-mails, OG tags, the sitemap and auth redirects.
# ==========================================================================

# Production: https://mazedland.vercel.app   ·   Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==========================================================================
# 3 · CRON  —  REQUIRED
# Guards /api/cron/*. The notify-sms and notify-email drains 503 without it.
# ==========================================================================

# Vercel sends it as `Authorization: Bearer`; the routes also accept ?key=.
# Keep it out of the pg_cron job URLs: migration 0158 reads it from Vault
# instead, and is applied once the secret has been rotated.
CRON_SECRET=

# ==========================================================================
# 4 · SMS  —  LIVE
# WinSMS.tn. This is the only transactional channel that currently works.
# ==========================================================================

# Without it the signup phone-OTP step is skipped entirely (isSmsConfigured()).
WINSMS_API_KEY=

# Approved sender ID.
WINSMS_SENDER_ID=MAZED

# Peppers the OTP hash in phone_otps AND signs the mz_phone_proof cookie.
# Falls back to SUPABASE_SERVICE_ROLE_KEY when unset, which works but ties
# OTP validity to that key: rotating it invalidates every in-flight OTP.
# Set a dedicated 32+ byte random value in production.
SMS_OTP_PEPPER=

# ==========================================================================
# 5 · E-MAIL  —  OPTIONAL
# Set both and transactional e-mail starts working on the next deploy.
# ==========================================================================

# Without BOTH of these /api/cron/notify-email is a silent no-op: it runs
# every 5 minutes, returns 200 and sends nothing, so every notification
# stays in-app and on SMS. Which kinds are sent is src/lib/email-kinds.ts.
RESEND_API_KEY=

# Must use a domain verified in Resend.
# Example:  EMAIL_FROM="Mazed Immo <no-reply@mazedimmo.tn>"
EMAIL_FROM="Mazed Immo <no-reply@example.tn>"

# ==========================================================================
# 6 · CONTACT DETAILS  —  OPTIONAL
# Both rows on /fr/contact hide themselves when unset; the page then says so.
# ==========================================================================

# Public. The row hides itself when unset — a mailbox that bounces is
# worse than no mailbox at all.
NEXT_PUBLIC_CONTACT_EMAIL=

# Public. The row hides itself when unset, rather than invent a number.
# Format it readably, e.g. "+216 70 123 456" — the tel: link strips the spaces.
NEXT_PUBLIC_CONTACT_PHONE=

# ==========================================================================
# 7 · AUTH  —  OPTIONAL
# Defaults are fine; set only if you move domains.
# ==========================================================================

# Synthetic address domain for phone-only accounts.
# Defaults to phone.mazedland.app when unset. Point it at a domain you OWN.
SIGNUP_EMAIL_DOMAIN=

# Refuses to boot against the wrong database. Leave empty unless you are
# deliberately moving the project to another Supabase ref.
EXPECTED_SUPABASE_REF=

# ==========================================================================
# 8 · TUNING  —  OPTIONAL
# Safe to leave empty. Shown so nothing is missing from this file.
# ==========================================================================

# Share of authenticated pageviews written to activity_log. Default 1.
# The pageview write is the highest-volume write in the system; drop this
# to 0.25 under load to cut write amplification without a redeploy.
ACTIVITY_PAGEVIEW_AUTH_SAMPLE=1

# Same for anonymous views. Default 0.1.
ACTIVITY_PAGEVIEW_ANON_SAMPLE=0.1

# error | warn | info | debug. Server.
LOG_LEVEL=

# Same, for the browser. Public.
NEXT_PUBLIC_LOG_LEVEL=

# 1 turns on the in-page performance probe. Public. Leave off in production.
NEXT_PUBLIC_PERF_PROBE=

# ==========================================================================
# 9 · LOCAL TOOLING  —  DO NOT PUT IN VERCEL
# Direct Postgres, used only by scripts/apply-migrations.mjs on your machine.
# ==========================================================================

# Pooler host, eu-west-1.
SB_HOST=aws-0-eu-west-1.pooler.supabase.com

# Project ref; the DB user is postgres.<ref>.
SB_REF=YOUR-PROJECT-REF

# Database password. Full superuser-level access to the database.
# There is no reason for this to exist in any hosted environment.
SB_DB_PASSWORD=

# ==========================================================================
# 10 · UNUSED  —  nothing in the codebase reads these
# ==========================================================================
#
# Payment gateway keys from an earlier plan. Mazed Immo is deliberately
# gateway-free: a seller transfers by bank wire or D17, uploads a receipt,
# and an admin verifies it under /admin/paiements. `grep -r process.env`
# returns no hit for any of the six. They are listed so this file is
# complete, and commented out so they are not shipped anywhere. Delete them
# once you are sure you are not going back to a gateway.
#
# D17_MERCHANT_ID=
# FLOUCI_APP_SECRET=
# FLOUCI_APP_TOKEN=
# KONNECT_API_KEY=
# KONNECT_WALLET_ID=
# PAYMEE_API_KEY=

# ==========================================================================
# 11 · SET FOR YOU  —  never put these in a file
# ==========================================================================
#
#   NODE_ENV, VERCEL, VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL, NEXT_PHASE
#     Injected by Next.js and by Vercel at build and run time.
#
#   LOADTEST_SUPABASE_URL, LOADTEST_ANON_KEY, LOADTEST_SERVICE_KEY, FORCE_PROD
#   USERS, VIEWERS, BIDS, BID_GAP_MS, DURATION_SEC, THINK_MS
#     Arguments to scripts/loadtest only — never application config. Point
#     the LOADTEST_* ones at a throwaway project, never at production.
